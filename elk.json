      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "logstash_node_jvm_mem_heap_used_percent or ((logstash_jvm_memory_used_bytes{area=\"heap\"} / logstash_jvm_memory_max_bytes{area=\"heap\"}) * 100)",
