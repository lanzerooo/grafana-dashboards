      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "id": 17,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(changes(etcd_server_leader_changes_seen_total{instance=~\"$instance\"}[1h]))",
          "legendFormat": "Смен за час",
          "refId": "A"
        }
      ],
      "title": "Смены Лидера (Leader Flapping / 1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Сетевая задержка передачи сообщений Raft между участниками кластера (Peer RTT). Норма: < 10ms.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
