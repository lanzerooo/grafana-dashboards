          "refId": "A"
        },
        {
          "expr": "sum by (To) (rate(etcd_network_peer_round_trip_time_seconds_sum{instance=~\"$instance\"}[2m])) / sum by (To) (rate(etcd_network_peer_round_trip_time_seconds_count{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Avg RTT к: {{To}}",
          "refId": "B"
        }
      ],
      "title": "Сетевой RTT между узлами etcd (Peer RTT Latency)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Статус предложений Raft: примененные (applied), зафиксированные (committed), зависшие (pending) и сбойные (failed).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "ops"
