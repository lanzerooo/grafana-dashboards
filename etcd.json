      "targets": [
        {
          "expr": "sum by (instance) (rate(etcd_server_slow_apply_total{instance=~\"$instance\"}[2m])) or (0 * sum(rate(etcd_server_proposals_applied_total{instance=~\"$instance\"}[2m])))",
          "legendFormat": "Slow Apply: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(etcd_server_slow_read_indexes_total{instance=~\"$instance\"}[2m])) or (0 * sum(rate(etcd_server_proposals_applied_total{instance=~\"$instance\"}[2m])))",
          "legendFormat": "Slow Read Index: {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Медленные операции (Slow Applies & Read Indexes)",
