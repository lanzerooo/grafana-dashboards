{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📌 Золотые сигналы etcd и Аварийные Алармы (Cluster Health & Alarms)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Признает ли выбранный узел наличие лидера в кластере (1 = Да, 0 = Потеря кворума). При значении 0 кластер изолирован и не может подтверждать транзакции.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "НЕТ ЛИДЕРА" }, "1": { "color": "green", "text": "КВОРУМ OK" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min(etcd_server_has_leader{instance=~\"$instance\"})",
          "legendFormat": "Кворум",
          "refId": "A"
        }
      ],
      "title": "Кворум (Has Leader)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Показывает, является ли выбранный узел активным лидером Raft (1 = Лидер, 0 = Фолловер).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "blue", "text": "FOLLOWER" }, "1": { "color": "green", "text": "LEADER" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max by (instance) (etcd_server_is_leader{instance=~\"$instance\"})",
          "legendFormat": "Роль узла",
          "refId": "A"
        }
      ],
      "title": "Роль узла (Leader / Follower)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Активные системные аварии etcd (NOSPACE — превышение квоты базы, CORRUPT — повреждение файла bbolt). Должно быть строго 0! Если > 0 — кластер заблокировал запись.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(etcd_server_alarm_state{instance=~\"$instance\"}) or (0 * sum(etcd_server_has_leader{instance=~\"$instance\"}))",
          "legendFormat": "Активных алармов",
          "refId": "A"
        }
      ],
      "title": "Алармы etcd (NOSPACE / CORRUPT)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Сколько байт осталось до достижения жесткого лимита квоты (--quota-backend-bytes). Рассчитывается как Quota - DB_Total_Size.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 536870912 },
              { "color": "green", "value": 1073741824 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min by (instance) (etcd_server_quota_backend_bytes{instance=~\"$instance\"} - etcd_mvcc_db_total_size_in_bytes{instance=~\"$instance\"})",
          "legendFormat": "Свободно до квоты: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Свободно до Квоты БД (Free Quota)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Свободное место на физическом дисковом разделе хоста, где смонтирована директория данных etcd (/var/lib/etcd).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5368709120 },
              { "color": "green", "value": 10737418240 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min by (instance) (node_filesystem_avail_bytes{mountpoint=~\"/var/lib/etcd|/var|/\"}) or min(node_filesystem_avail_bytes{mountpoint=\"/\"})",
          "legendFormat": "Свободно на диске: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Свободно на физическом диске хоста",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Процент свободного неиспользуемого места внутри файла базы bbolt ((Total - InUse) / Total * 100). Если фрагментация > 50% — требуется дефрагментация (etcdctl defrag).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "((max by (instance) (etcd_mvcc_db_total_size_in_bytes{instance=~\"$instance\"}) - max by (instance) (etcd_mvcc_db_total_size_in_use_in_bytes{instance=~\"$instance\"})) / max by (instance) (etcd_mvcc_db_total_size_in_bytes{instance=~\"$instance\"})) * 100",
          "legendFormat": "% Фрагментации: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Фрагментация БД (% Fragmentation)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "💾 Дисковая подсистема, WAL, Свободное Место и Файловая Система",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Задержка сброса журнала WAL на диск (fsync). Норма P99: строго < 10ms. Если задержка > 15-20ms — диск перегружен, начинаются пропуски heartbeats и перевыборы лидера.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.02 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(etcd_disk_wal_fsync_duration_seconds_bucket{instance=~\"$instance\"}[2m])))",
          "legendFormat": "P99 fsync: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(etcd_disk_wal_fsync_duration_seconds_sum{instance=~\"$instance\"}[2m])) / sum by (instance) (rate(etcd_disk_wal_fsync_duration_seconds_count{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Avg fsync: {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Задержка записи WAL на диск (WAL Fsync Duration)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Задержка фиксации транзакций bbolt на диск (Backend Commit). Норма: < 25ms. Высокие значения указывают на перегрузку случайной записью.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.025 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(etcd_disk_backend_commit_duration_seconds_bucket{instance=~\"$instance\"}[2m])))",
          "legendFormat": "P99 commit: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(etcd_disk_backend_commit_duration_seconds_sum{instance=~\"$instance\"}[2m])) / sum by (instance) (rate(etcd_disk_backend_commit_duration_seconds_count{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Avg commit: {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Задержка фиксации транзакций БД (Backend Commit Duration)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Соотношение физического размера файла базы данных bbolt, фактически используемого объема полезных данных и лимита квоты.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max by (instance) (etcd_mvcc_db_total_size_in_bytes{instance=~\"$instance\"})",
          "legendFormat": "Размер файла БД: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "max by (instance) (etcd_mvcc_db_total_size_in_use_in_bytes{instance=~\"$instance\"})",
          "legendFormat": "Полезный объем (In-Use): {{instance}}",
          "refId": "B"
        },
        {
          "expr": "max(etcd_server_quota_backend_bytes{instance=~\"$instance\"})",
          "legendFormat": "Лимит квоты (Quota Limit)",
          "refId": "C"
        }
      ],
      "title": "Размер БД vs Полезный объем и Лимит Квоты",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Абсолютный объем мусора и пустых B-Tree страниц в базе в мегабайтах/гигабайтах. Показывает, сколько именно дискового пространства высвободит дефрагментация.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max by (instance) (etcd_mvcc_db_total_size_in_bytes{instance=~\"$instance\"} - etcd_mvcc_db_total_size_in_use_in_bytes{instance=~\"$instance\"})",
          "legendFormat": "Объем мусора (Фрагментация): {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Объем фрагментированного места в байтах (Wasted Space)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Свободное место на дисковом разделе хоста (/var/lib/etcd) и процент использования Inodes. Позволяет предотвратить сбой по причине переполнения диска хоста.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=~\"/var/lib/etcd|/var|/\"}",
          "legendFormat": "Свободно на FS: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Физическое свободное место на диске хоста (Host FS Free)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Длительность сохранения снапшота на диск. Если сохранение занимает > 5-10 секунд, диск блокируется во время snapshot transfer.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(etcd_debugging_snap_save_total_duration_seconds_bucket{instance=~\"$instance\"}[5m]))) or (sum(rate(etcd_debugging_snap_save_total_duration_seconds_sum{instance=~\"$instance\"}[5m])) / sum(rate(etcd_debugging_snap_save_total_duration_seconds_count{instance=~\"$instance\"}[5m]))) or (0 * sum(rate(etcd_server_proposals_applied_total{instance=~\"$instance\"}[2m])))",
          "legendFormat": "Snapshot Save P99",
          "refId": "A"
        }
      ],
      "title": "Длительность сохранения снапшотов (Snapshot Save Duration)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "🗄️ MVCC: Ревизии, Ключи, Отставание Компактизации и Аренды (Leases)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Разница между текущей ревизией базы и последней уплотненной (Current Revision - Compact Revision). Рост графика означает, что компактизация не успевает за потоком изменений, и база быстро раздувается.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "(max by (instance) (etcd_debugging_mvcc_current_revision{instance=~\"$instance\"}) or max by (instance) (etcd_mvcc_current_revision{instance=~\"$instance\"})) - (max by (instance) (etcd_debugging_mvcc_compact_revision{instance=~\"$instance\"}) or max by (instance) (etcd_mvcc_compact_revision{instance=~\"$instance\"}))",
          "legendFormat": "Отставание компактизации: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Отставание ревизии компактизации (MVCC Revision Lag)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Общее количество актуальных ключей в хранилище MVCC. Позволяет заметить аномальный рост числа объектов в кластере (Events, Secrets, ConfigMaps).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 14,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max by (instance) (etcd_debugging_mvcc_keys_total{instance=~\"$instance\"}) or max by (instance) (etcd_mvcc_keys_total{instance=~\"$instance\"})",
          "legendFormat": "Ключей в БД: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Количество ключей в хранилище (MVCC Keys Total)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Активность механизма аренды ключей (Leases): выданные (granted), отозванные (revoked) и продлеваемые (renew). Используется в Kubernetes для координации лидеров и отслеживания узлов (Node Heartbeats).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "id": 15,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (instance) (rate(etcd_debugging_lease_renew_total{instance=~\"$instance\"}[2m])) or sum by (instance) (rate(etcd_lease_renew_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Lease Renew: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(etcd_debugging_lease_granted_total{instance=~\"$instance\"}[2m])) or sum by (instance) (rate(etcd_lease_granted_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Lease Granted: {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sum by (instance) (rate(etcd_debugging_lease_revoked_total{instance=~\"$instance\"}[2m])) or sum by (instance) (rate(etcd_lease_revoked_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Lease Revoked: {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Активность механизмов аренды (Lease Operations)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Скорость автоматической компактизации старых ревизий и длительность одного цикла уплотнения.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "id": 16,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (instance) (rate(etcd_debugging_mvcc_db_compaction_total_duration_milliseconds_count{instance=~\"$instance\"}[2m])) or sum by (instance) (rate(etcd_mvcc_db_compaction_total_duration_milliseconds_count{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Компактизаций / сек: {{instance}}",
          "refId": "A"
        }
