      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (instance) (rate(etcd_server_proposals_applied_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "Applied: {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (rate(etcd_server_proposals_failed_total{instance=~\"$instance\"}[2m])) or (0 * sum by (instance) (rate(etcd_server_proposals_applied_total{instance=~\"$instance\"}[2m])))",
          "legendFormat": "Failed: {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sum by (instance) (etcd_server_proposals_pending{instance=~\"$instance\"})",
          "legendFormat": "Pending: {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Предложения Raft (Applied vs Failed vs Pending)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Медленные операции применения изменений (Slow Applies) и медленные линейные чтения (Slow Read Indexes). Должно быть строго 0! Появление всплесков означает микрофризы диска или блокировку CPU.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
