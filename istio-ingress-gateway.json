      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_server_worker_0_poll_delay_us_bucket{pod=~\"$pod\"}[2m]))) / 1000000 or (0 * sum(rate(envoy_http_downstream_rq_total{pod=~\"$pod\"}[2m])))",
          "legendFormat": "P99 Worker Event Loop Delay",
          "refId": "A"
        }
      ],
      "title": "Задержка Event Loop воркеров (Worker Poll Delay)",
      "type": "timeseries"
    }
