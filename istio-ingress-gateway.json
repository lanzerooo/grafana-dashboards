{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📌 Золотые сигналы шлюзов (Golden Signals & Connection Mesh)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Общий входящий трафик на выбранные Ingress Gateway в запросах в секунду (RPS). Показывает суммарную нагрузку с внешнего периметра.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])) or sum(rate(envoy_http_downstream_rq_total{pod=~\"$pod\"}[2m]))",
          "legendFormat": "Входящий RPS",
          "refId": "A"
        }
      ],
      "title": "Общий входящий RPS (Edge Ingress Traffic)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Процент запросов, завершившихся серверной ошибкой 5xx (500, 502, 503, 504). Норма: < 0.1%. Если значение растет — шлюз не может связаться с бэкендами (UH/UF) или бэкенды падают с паникой.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",response_code=~\"5..\"}[2m])) / sum(rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) * 100 or (0 * sum(rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "% Ошибок 5xx",
          "refId": "A"
        }
      ],
      "title": "Доля серверных ошибок (% 5xx Errors)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "99-й перцентиль времени ответа шлюза клиенту (сквозная задержка Edge-to-Client). Включает в себя обработку Envoy, TLS handshake и задержку целевого микросервиса.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.99, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000) or ((sum(rate(istio_request_duration_milliseconds_sum{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])) / sum(rate(istio_request_duration_milliseconds_count{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000)",
          "legendFormat": "P99 / Avg Latency",
          "refId": "A"
        }
      ],
      "title": "P99 Задержка ответа клиенту (Edge Latency)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Фактическое количество активных TCP-соединений от клиентов к подам Ingress Gateway прямо сейчас. Рассчитывается через метрики листенеров Envoy либо дельту открытых/закрытых соединений Istio.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(envoy_listener_downstream_cx_active{pod=~\"$pod\"}) or sum(istio_tcp_connections_opened_total{pod=~\"$pod\"} - istio_tcp_connections_closed_total{pod=~\"$pod\"}) or sum(envoy_server_total_connections{pod=~\"$pod\"}) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "Активные соединения",
          "refId": "A"
        }
      ],
      "title": "Активные клиентские соединения (Downstream Connections)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🗺️ Наглядный Роутинг и Карта Маршрутизации (Traffic Flow & Routing Map)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Сводная таблица сквозного роутинга: показывает, с какого именно Gateway трафик уходит в целевой Namespace, на какой микросервис (VirtualService/DestinationRule), с какими HTTP статус-кодами и текущим RPS.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "unit", "value": "reqps" }, { "id": "displayName", "value": "Интенсивность (RPS)" }]
          },
          {
            "matcher": { "id": "byName", "options": "source_workload" },
            "properties": [{ "id": "displayName", "value": "Шлюз (Gateway)" }]
          },
          {
            "matcher": { "id": "byName", "options": "destination_service_namespace" },
            "properties": [{ "id": "displayName", "value": "Целевой Namespace" }]
          },
          {
            "matcher": { "id": "byName", "options": "destination_service_name" },
            "properties": [{ "id": "displayName", "value": "Целевой Сервис (Backend)" }]
          },
          {
            "matcher": { "id": "byName", "options": "response_code" },
            "properties": [{ "id": "displayName", "value": "HTTP Код" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "footer": { "enablePagination": true, "fields": "", "reducer": ["sum"], "show": true },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Интенсивность (RPS)" }]
      },
      "targets": [
        {
          "expr": "topk(25, sum by (source_workload, destination_service_namespace, destination_service_name, response_code) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",destination_service_namespace=~\"$destination_namespace\",destination_service_name=~\"$destination_service\"}[2m])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Сводная матрица роутинга: Gateway -> Namespace -> Service -> HTTP Код",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Распределение входящего трафика по целевым микросервисам (бэкендам). Показывает, на какие внутренние сервисы шлюз отдает больше всего нагрузки.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "topk(10, sum by (destination_service_name) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",destination_service_namespace=~\"$destination_namespace\",destination_service_name=~\"$destination_service\"}[2m])))",
          "legendFormat": "Сервис: {{destination_service_name}}",
          "refId": "A"
        }
      ],
      "title": "Трафик по целевым сервисам (Destination Services RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Разбивка трафика по целевым пространствам имен (Namespaces). Позволяет увидеть пропорции потребления внешнего трафика разными проектами/командами.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (destination_service_namespace) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",destination_service_namespace=~\"$destination_namespace\"}[2m]))",
          "legendFormat": "Namespace: {{destination_service_namespace}}",
          "refId": "A"
        }
      ],
      "title": "Трафик по целевым неймспейсам (Namespaces RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Разбивка по протоколам (HTTP/1.1, HTTP/2, gRPC) и методам (GET, POST, PUT, DELETE, OPTIONS). Позволяет отследить gRPC-стримы и аномальные наплывы мутирующих запросов.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (request_protocol) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))",
          "legendFormat": "Протокол: {{request_protocol}}",
          "refId": "A"
        }
      ],
      "title": "Трафик по транспортным протоколам (Protocols: HTTP/1.1 vs HTTP/2 vs gRPC)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Распределение входящего трафика по HTTP-методам (GET, POST, PUT, DELETE, OPTIONS, HEAD).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (request_method) (rate(envoy_http_downstream_rq_total{pod=~\"$pod\"}[2m])) or sum by (destination_service_name) (0 * rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))",
          "legendFormat": "Метод: {{request_method}}",
          "refId": "A"
        }
      ],
      "title": "Трафик по HTTP-методам (Verbs: GET, POST, PUT, etc.)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "🚩 Траблшутинг Маршрутизации и Флаги Envoy (Response Flags Diagnostic)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Ключевая диагностика Envoy: UH = нет живых подов бэкенда (503); NR = нет совпадения по хосту/пути в VirtualService (404); UT = таймаут запроса к бэкенду (504); DC = клиент сам оборвал связь (499); UF = ошибка TCP/TLS к бэкенду; UO = сработал Circuit Breaker (503).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (response_flags) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",response_flags!=\"-\"}[2m])) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "Флаг Envoy: {{response_flags}}",
          "refId": "A"
        }
      ],
      "title": "Флаги сбоев Envoy (Response Flags: UH, NR, UT, DC, UF, UO)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Ошибки роутинга NR (No Route Configured / HTTP 404). Означает, что клиенты обращаются на домен или URI-префикс, для которого нет соответствующего правила в VirtualService.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "errps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",response_flags=\"NR\"}[2m])) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "No Route к: {{destination_service_name}}",
          "refId": "A"
        }
      ],
      "title": "Ошибки отсутствия маршрута (Response Flag: NR / No Route)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Ошибки отсутствия здоровых подов (Response Flag: UH / No Healthy Upstream / HTTP 503). Позволяет мгновенно увидеть, в каком именно сервисе все поды упали или не прошли Readiness Probe.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "errps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (destination_service_name, destination_service_namespace) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",response_flags=\"UH\"}[2m])) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "Нет подов у: {{destination_service_namespace}}/{{destination_service_name}}",
          "refId": "A"
        }
      ],
      "title": "Отвал подов бэкенда (Response Flag: UH / No Healthy Upstream)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Таймауты ожидания ответа бэкендов (Response Flag: UT / Upstream Request Timeout / HTTP 504). Показывает сервисы, которые не успевают ответить за лимит времени, заданный в VirtualService.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "errps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\",response_flags=\"UT\"}[2m])) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "Таймаут у: {{destination_service_name}}",
          "refId": "A"
        }
      ],
      "title": "Таймауты бэкендов (Response Flag: UT / Upstream Timeout)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "id": 103,
      "title": "⚡ Задержки (Latency): Клиент vs Upstream Кластеры",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Квантили P50, P90, P99 времени генерации ответа шлюзом. Если P99 резко уходит вверх при стабильном P50 — задержки вызваны только частью тяжелых сервисов.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 14,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000",
          "legendFormat": "P99 Edge Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000",
          "legendFormat": "P90 Edge Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000",
          "legendFormat": "P50 Edge Latency",
          "refId": "C"
        },
        {
          "expr": "(sum(rate(istio_request_duration_milliseconds_sum{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])) / sum(rate(istio_request_duration_milliseconds_count{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000",
          "legendFormat": "Avg Edge Latency",
          "refId": "D"
        }
      ],
      "title": "Квантили сквозного времени ответа (Client Response Latency)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Топ-7 самых медленных микросервисов по времени генерации ответа (P99). Позволяет доказать, что задержка происходит на стороне кода бэкенда, а не на сетевом шлюзе.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 15,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "topk(7, histogram_quantile(0.99, sum by (destination_service_name, le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m]))) / 1000)",
          "legendFormat": "P99 {{destination_service_name}}",
          "refId": "A"
        }
      ],
      "title": "Топ медленных бэкендов по P99 (Slowest Upstream Services)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "id": 104,
      "title": "🔒 TLS, Сертификаты Gateways и Защита (SSL/TLS Security)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Интенсивность новых TLS рукопожатий (Handshakes) в секунду на шлюзе.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 57 },
      "id": 16,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(envoy_ssl_handshake{pod=~\"$pod\"}[2m]))",
          "legendFormat": "TLS Handshakes / сек",
          "refId": "A"
        }
      ],
      "title": "Частота TLS Handshakes (Новые HTTPS клиенты)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Ошибки TLS рукопожатий (несовпадение версий TLS, отсутствие общих шифров, разрывы handshake клиентами).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "errps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 57 },
      "id": 17,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(envoy_ssl_connection_error{pod=~\"$pod\"}[2m])) or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "Сбои TLS Handshake",
          "refId": "A"
        }
      ],
      "title": "Сбои TLS Handshakes (Connection Errors)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Дней до истечения публичных SSL/TLS сертификатов, смонтированных в Gateway (через Secret или SDS). Если срок < 15 дней — cert-manager не смог обновить сертификат.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 57 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min by (pod) (envoy_server_days_until_first_cert_expiring{pod=~\"$pod\"}) or min by (pod) ((envoy_sds_certificate_expiration_timestamp{pod=~\"$pod\"} - time()) / 86400)",
          "legendFormat": "Дней до истечения: {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Срок действия SSL сертификатов (Days to Expiry)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
      "id": 105,
      "title": "⚙️ Системные ресурсы и Воркеры Envoy (Saturation & Workers)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Потребление ядер процессора (CPU Cores) каждым подом Ingress Gateway. Если CPU приближается к лимиту, Event Loop Envoy замедляется, вызывая резкий рост задержек.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 66 },
      "id": 19,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"istio-proxy\",pod=~\"$pod\"}[2m]))",
          "legendFormat": "CPU Cores: {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Утилизация CPU (Ingress Gateway Cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Оперативная память подов шлюза: Working Set контейнера и память, фактически аллоцированная Envoy (Memory Allocated).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 66 },
      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{container=\"istio-proxy\",pod=~\"$pod\"})",
          "legendFormat": "Working Set RSS: {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (envoy_server_memory_allocated{pod=~\"$pod\"})",
          "legendFormat": "Envoy Allocated: {{pod}}",
          "refId": "B"
        }
      ],
      "title": "Потребление памяти (Resident & Envoy Allocated)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Задержка цикла опроса воркеров Envoy (Worker Poll Delay). Норма: < 1-2ms. Если задержка > 10ms — воркеры Envoy перегружены блокирующими вызовами или троттлятся ядром по CPU.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 66 },
      "id": 21,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_server_worker_0_poll_delay_us_bucket{pod=~\"$pod\"}[2m]))) / 1000000 or (0 * sum(rate(istio_requests_total{source_workload=~\"$gateway_workload\",pod=~\"$pod\"}[2m])))",
          "legendFormat": "P99 Worker Event Loop Delay",
          "refId": "A"
        }
      ],
      "title": "Задержка Event Loop воркеров (Worker Poll Delay)",
      "type": "timeseries"
    }
  ],
