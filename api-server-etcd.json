{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📌 Золотые сигналы Control-Plane (Executive APIServer & etcd Health)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Общая интенсивность входящих запросов к kube-apiserver в секунду (RPS). Резкие скачки отражают волны деплоев, циклы автомасштабирования или шторм запросов от сбойных операторов.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m]))",
          "legendFormat": "APIServer RPS",
          "refId": "A"
        }
      ],
      "title": "APIServer RPS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Процент запросов к API, завершившихся серверной ошибкой 5xx. Норма: < 0.05%. Если значение > 1%, apiserver или бэкенд etcd испытывают отказ в обслуживании.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\",code=~\"5..\"}[2m])) / sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m]))) * 100 or (0 * sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m])))",
          "legendFormat": "% Ошибок 5xx",
          "refId": "A"
        }
      ],
      "title": "Доля ошибок 5xx (API Errors)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "P99 / среднее время ответа kube-apiserver (без учета потоковых WATCH и CONNECT). Норма: < 200-500ms. Рост выше 1s сигнализирует о деградации etcd или медленных вебхуках.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(apiserver_request_duration_seconds_bucket{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m]))) or (sum(rate(apiserver_request_duration_seconds_sum{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])) / sum(rate(apiserver_request_duration_seconds_count{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])))",
          "legendFormat": "P99 / Avg Latency",
          "refId": "A"
        }
      ],
      "title": "P99 Задержка API (API Latency)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Статус кворума Raft: 1 = Кворум есть, лидер признан всеми узлами; 0 = Потеря кворума, кластер etcd перешел в аварийное состояние.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "НЕТ КВОРУМА" }, "1": { "color": "green", "text": "КВОРУМ OK" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min(etcd_server_has_leader{instance=~\"$etcd_instance\"})",
          "legendFormat": "Кворум",
          "refId": "A"
        }
      ],
      "title": "Кворум etcd (Raft Quorum)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Критическая метрика etcd: время сброса журнала упреждающей записи WAL на диск (fsync). Норма: строго < 10ms. Превышение 15-20ms вызывает срыв Raft heartbeats и перевыборы лидера.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.02 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(etcd_disk_wal_fsync_duration_seconds_bucket{instance=~\"$etcd_instance\"}[2m]))) or (sum(rate(etcd_disk_wal_fsync_duration_seconds_sum{instance=~\"$etcd_instance\"}[2m])) / sum(rate(etcd_disk_wal_fsync_duration_seconds_count{instance=~\"$etcd_instance\"}[2m])))",
          "legendFormat": "P99 WAL fsync",
          "refId": "A"
        }
      ],
      "title": "etcd WAL Fsync P99 (SLA < 10ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Процент использования выделенной квоты диска (--quota-backend-bytes, по умолчанию 2GB, макс 8GB). При приближении к 90-100% etcd включает alarm:NOSPACE и блокирует любые операции записи.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(max(etcd_mvcc_db_total_size_in_bytes{instance=~\"$etcd_instance\"}) / max(etcd_server_quota_backend_bytes{instance=~\"$etcd_instance\"})) * 100",
          "legendFormat": "% Квоты БД",
          "refId": "A"
        }
      ],
      "title": "etcd Заполнение квоты (% Quota)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🚦 Трафик, Коды Ответов и Приоритизация API (APF & Flow Control)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Распределение интенсивности запросов к kube-apiserver по кодам ответов HTTP (2xx, 3xx, 4xx, 5xx).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (code) (rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m]))",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ],
      "title": "Запросы по HTTP статус-кодам (Status Codes)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Интенсивность запросов по типам операций (Verbs: GET, LIST, POST, PUT, PATCH, DELETE, WATCH). Высокая доля LIST без постраничной пагинации создает критическую нагрузку на оперативную память API-сервера.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (verb) (rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m]))",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ],
      "title": "Интенсивность по типам операций (Verbs)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Запросы, отклоненные механизмом API Priority and Fairness (HTTP 429 Too Many Requests). Если график растет — клиенты превышают лимиты выделенных очередей FlowSchema.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (priority_level, reason) (rate(apiserver_flowcontrol_rejected_requests_total{instance=~\"$apiserver_instance\"}[2m])) or (0 * sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m])))",
          "legendFormat": "{{priority_level}} ({{reason}})",
          "refId": "A"
        }
      ],
      "title": "Отклоненные запросы APF (HTTP 429 Throttling)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "P99 времени ожидания запроса в очередях планирования APF до начала его исполнения. Значения > 50-100ms свидетельствуют о нехватке слотов параллелизма (concurrency shares).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (priority_level, le) (rate(apiserver_flowcontrol_request_wait_duration_seconds_bucket{instance=~\"$apiserver_instance\"}[2m]))) or (0 * sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m])))",
          "legendFormat": "P99 Очередь: {{priority_level}}",
          "refId": "A"
        }
      ],
      "title": "Время ожидания в очередях APF (Queue Wait Latency)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Текущее количество запросов, находящихся в процессе исполнения прямо сейчас, с разбивкой на модифицирующие (mutating) и запросы чтения (readOnly).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (request_kind) (apiserver_current_inflight_requests{instance=~\"$apiserver_instance\"})",
          "legendFormat": "In-flight: {{request_kind}}",
          "refId": "A"
        }
      ],
      "title": "Активные In-Flight запросы (Mutating vs ReadOnly)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Топ-10 самых запрашиваемых ресурсов кластера. Позволяет мгновенно вычислить источник шторма запросов (например, частый поллинг configmaps, pods или crd).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "topk(10, sum by (resource) (rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m])))",
          "legendFormat": "Ресурс: {{resource}}",
          "refId": "A"
        }
      ],
      "title": "Топ-10 ресурсов по нагрузке (Top Requests by Resource)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "⚡ Задержки APIServer и Траблшутинг Admission Webhooks",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Квантили времени ответа kube-apiserver и средняя задержка. Если растет P99 при стабильном P50 — проблема точечная (тяжелый запрос или один медленный вебхук). Если растет P50 — деградирует вся подсистема control-plane.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(apiserver_request_duration_seconds_bucket{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])))",
          "legendFormat": "P99 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(apiserver_request_duration_seconds_bucket{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])))",
          "legendFormat": "P90 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(apiserver_request_duration_seconds_bucket{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])))",
          "legendFormat": "P50 Latency",
          "refId": "C"
        },
        {
          "expr": "sum(rate(apiserver_request_duration_seconds_sum{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])) / sum(rate(apiserver_request_duration_seconds_count{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m]))",
          "legendFormat": "Avg Latency",
          "refId": "D"
        }
      ],
      "title": "Квантили времени ответа kube-apiserver (Response Latency)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Топ-7 самых медленных комбинаций Verb + Resource по фактическому среднему времени выполнения. Позволяет мгновенно определить, какая сущность кластера создает задержки.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 14,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "topk(7, sum by (verb, resource) (rate(apiserver_request_duration_seconds_sum{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])) / sum by (verb, resource) (rate(apiserver_request_duration_seconds_count{instance=~\"$apiserver_instance\",subresource!=\"log\",verb!~\"WATCH|CONNECT\"}[2m])) > 0)",
          "legendFormat": "{{verb}} {{resource}} (avg)",
          "refId": "A"
        }
      ],
      "title": "Топ медленных операций по ресурсам (Slowest Verb + Resource)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Задержка ответов от внешних Admission Webhooks (OPA, Kyverno, cert-manager, Istio-injector). Если вебхук отвечает дольше 500ms или таймаутит (10s) — создание и изменение подов полностью блокируется.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "id": 15,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "topk(7, histogram_quantile(0.99, sum by (name, le) (rate(apiserver_admission_webhook_admission_duration_seconds_bucket{instance=~\"$apiserver_instance\"}[2m]))))",
          "legendFormat": "P99 Webhook: {{name}}",
          "refId": "A"
        },
        {
          "expr": "topk(7, sum by (name) (rate(apiserver_admission_webhook_admission_duration_seconds_sum{instance=~\"$apiserver_instance\"}[2m])) / sum by (name) (rate(apiserver_admission_webhook_admission_duration_seconds_count{instance=~\"$apiserver_instance\"}[2m])) > 0)",
          "legendFormat": "Avg Webhook: {{name}}",
          "refId": "B"
        }
      ],
      "title": "Задержка Admission Webhooks (P99 / Avg Latency)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Отказы и ошибки вызовов Admission Webhooks. Включает сетевые таймауты и отклонения запросов. При failurePolicy=Fail это приводит к сбоям создания подов.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "errps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "id": 16,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (name, type) (rate(apiserver_admission_webhook_rejection_count{instance=~\"$apiserver_instance\"}[2m])) or (0 * sum(rate(apiserver_request_total{instance=~\"$apiserver_instance\"}[2m])))",
          "legendFormat": "Rejection: {{name}} ({{type}})",
          "refId": "A"
        }
      ],
      "title": "Ошибки и отклонения Admission Webhooks (Rejections)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "id": 103,
      "title": "🤝 etcd Core: Raft Кворум, Лидерство и Сеть Пиров (Raft & Peers)",
      "type": "row"
    },
    {
